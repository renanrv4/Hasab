-- Assinatura de funÃ§Ã£o
somaLista :: [Int] -> Int

concatenation :: [String] -> String

multFloat :: Float -> Float

f :: Int -> Int

-- DefiniÃ§Ã£o de funÃ§Ã£o
distancia :: Float -> Float -> Float

distancia x y =
    sqrt (x^2 + y^2)

-- DefiniÃ§Ã£o sem assinatura
dobro x =
    x * 2

-- FunÃ§Ãµes com mais de um parÃ¢metro
soma x y =
    x + y

-- ComposiÃ§Ã£o de chamadas
distanciaOrigem x y =
    sqrt (x^2 + y^2)
$ cabal run -v0 parser-test
>
[ DeclarationStatement
    ( FuncAnnot "somaLista"
        [ TyList TyInt
        , TyInt
        ]
    )
, DeclarationStatement
