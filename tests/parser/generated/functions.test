            ( LitInt 2 )
        )
    )
, DeclarationStatement
    ( FuncDef "soma"
        [ "x"
        , "y"
        ]
        ( BinaryOp Add
            ( Var "x" )
            ( Var "y" )
        )
    )
, DeclarationStatement
    ( FuncDef "distanciaOrigem"
