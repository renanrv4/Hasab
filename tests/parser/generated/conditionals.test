# conditionals - Caso 1
<
-- Condicional simples
if (x > 0) then x else 0

if true then 1 else 0

-- Condicional em uma funÃ§Ã£o
f x =
    if x > 0
    then x + 1
    else x - 1

-- Condicionais aninhadas
classificar x =
    if x > 0
    then
        if x > 10
        then 2
        else 1
    else 0
$ cabal run -v0 parser-test
>
[ ExprStatement
    ( IfThenElse
        ( BinaryOp Gt
            ( Var "x" )
            ( LitInt 0 )
        )
        ( Var "x" )
        ( LitInt 0 )
    )
, ExprStatement
    ( IfThenElse ( LitBool True )
        ( LitInt 1 )
        ( LitInt 0 )
    )
, DeclarationStatement
    ( FuncDef "f" [ "x" ]
        ( IfThenElse
            ( BinaryOp Gt
                ( Var "x" )
                ( LitInt 0 )
            )
            ( BinaryOp Add
                ( Var "x" )
                ( LitInt 1 )
            )
            ( BinaryOp Sub
                ( Var "x" )
                ( LitInt 1 )
            )
        )
    )
, DeclarationStatement
    ( FuncDef "classificar" [ "x" ]
        ( IfThenElse
            ( BinaryOp Gt
                ( Var "x" )
                ( LitInt 0 )
            )
            ( IfThenElse
                ( BinaryOp Gt
                    ( Var "x" )
                    ( LitInt 10 )
                )
                ( LitInt 2 )
                ( LitInt 1 )
            )
            ( LitInt 0 )
        )
    )
]
>= 0

